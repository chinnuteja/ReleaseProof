{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@releaseproof/contracts": ["../../packages/contracts/src/index.ts"],
      "@releaseproof/core": ["../../packages/core/src/index.ts"]
    },
    "lib": ["ES2024", "DOM"],
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "incremental": true,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/contracts/src/**/*.ts",
    "../../packages/core/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
